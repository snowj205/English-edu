<!DOCTYPE html>
<html lang="ko">

<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">

<title>Twinkle Storybook</title>

<style>

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  background: #eee9e1;
  font-family: Arial, "Malgun Gothic", sans-serif;
  color: #344054;
  overflow-x: hidden;
}

header {
  text-align: center;
  padding: 20px 10px 10px;
}

header h2 {
  margin: 0;
  font-size: 23px;
  color: #68594f;
}

header p {
  color: #999;
  font-size: 13px;
}

/* 책 영역 */

.book-wrap {
  width: 100%;
  display: flex;
  justify-content: center;
  padding: 15px;
  perspective: 1800px;
}

.book {
  width: 960px;
  max-width: 100%;
  aspect-ratio: 1.45 / 1;
  min-height: 400px;
  position: relative;
  display: flex;
  background: #fffdf7;
  box-shadow: 0 15px 35px #0002;
  border-radius: 8px;
}

/* 페이지 */

.page {
  width: 50%;
  height: 100%;
  position: relative;
  padding: 35px;
  overflow: hidden;
  background: #fffdf7;
}

.left-page {
  border-right: 1px solid #e9e1d5;
  border-radius: 8px 0 0 8px;
  box-shadow: inset -12px 0 20px -20px #777;
}

.right-page {
  border-radius: 0 8px 8px 0;
  box-shadow: inset 12px 0 20px -20px #777;
}

.page-inner {
  height: 100%;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  position: relative;
}

.page-image-wrap {
  width: 100%;
  flex: 1;
  min-height: 0;
  position: relative;
  display: flex;
  justify-content: center;
  align-items: center;
}

.page-image {
  max-width: 100%;
  max-height: 100%;
  object-fit: contain;
  border-radius: 8px;
}

.hotspot {
  position: absolute;
  border: 2px dashed transparent;
  background: transparent;
  cursor: pointer;
  border-radius: 50%;
  z-index: 2;
}

.hotspot:hover {
  border-color: #ffb64d;
  background: #ffffff30;
}

.story-text {
  width: 100%;
  text-align: center;
  font-size: 20px;
  line-height: 1.9;

  margin-top: -35px;

  position: relative;
  z-index: 3;
}

.story-sentence {
  display: block;
  cursor: pointer;
  padding: 2px 5px;
  border-radius: 6px;
}

.story-sentence:hover {
  background: #fff0cc;
}

.story-sentence.active {
  background: #ffe39c;
}

.word {
  display: inline-block;
  padding: 0 2px;
  border-radius: 4px;
}

.word.active {
  background: #ffd66b;
  color: #754c00;
}

.page-number {
  position: absolute;
  bottom: 12px;
  color: #aaa;
  font-size: 12px;
}

/* 넘김 버튼 */

.controls {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 25px;
  margin: 15px 0 25px;
}

.controls button {
  background: #897666;
  color: white;
  border: none;
  padding: 12px 24px;
  border-radius: 30px;
  cursor: pointer;
  font-size: 15px;
}

.controls button:disabled {
  opacity: .3;
}

#pageInfo {
  font-size: 14px;
  color: #777;
}

/* 3D 책장 */

.turning-page {
  position: absolute;
  width: 50%;
  height: 100%;
  top: 0;
  right: 0;
  z-index: 10;
  background: #fffdf7;
  transform-origin: left center;
  backface-visibility: hidden;
  pointer-events: none;
  border-left: 1px solid #ddd2c4;
  box-shadow: 5px 5px 20px #0002;
}

.turning-page.next {
  animation: nextPage .65s ease-in-out forwards;
}

.turning-page.prev {
  animation: prevPage .65s ease-in-out forwards;
}

@keyframes nextPage {
  0% {
    transform: rotateY(0deg);
  }
  100% {
    transform: rotateY(-180deg);
  }
}

@keyframes prevPage {
  0% {
    transform: rotateY(-180deg);
  }
  100% {
    transform: rotateY(0deg);
  }
}

/* 하단 기능 */

.bottom-tools {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 12px;
  margin-bottom: 20px;
}

.bottom-tools button {
  border: none;
  padding: 10px 18px;
  background: white;
  color: #766455;
  border-radius: 20px;
  cursor: pointer;
  box-shadow: 0 2px 5px #0001;
}

.bottom-tools button:hover {
  background: #fff0d9;
}

/* 이미지 교체 */

.upload-area {
  max-width: 500px;
  margin: 20px auto;
  padding: 15px;
  background: white;
  border-radius: 12px;
  text-align: center;
}

.upload-area label {
  display: block;
  font-size: 14px;
  margin-bottom: 10px;
}

.upload-area input {
  max-width: 100%;
}

#uploadStatus {
  font-size: 12px;
  color: #999;
}

@media(max-width:650px) {

  header h2 {
    font-size: 19px;
  }

  .book-wrap {
    padding: 8px;
  }

  .book {
    aspect-ratio: 0.9 / 1;
    min-height: 430px;
  }

  .page {
    padding: 15px 9px 25px;
  }

  .story-text {
    font-size: 14px;
    line-height: 1.7;
  }

  .controls {
    gap: 12px;
  }

  .controls button {
    padding: 10px 15px;
    font-size: 13px;
  }

}

</style>
</head>


<body>

<header>

  <h2>📖 Twinkle Storybook</h2>

  <p>Touch the pictures and enjoy the story!</p>

</header>


<div class="book-wrap">

  <div class="book" id="book">

    <div class="page left-page">

      <div class="page-inner" id="leftPage"></div>

    </div>

    <div class="page right-page">

      <div class="page-inner" id="rightPage"></div>

    </div>

    <div class="turning-page" id="turningPage"></div>

  </div>

</div>


<div class="controls">

  <button id="prevBtn" onclick="turnPage(-1)">
    ◀ Previous
  </button>

  <span id="pageInfo"></span>

  <button id="nextBtn" onclick="turnPage(1)">
    Next ▶
  </button>

</div>


<div class="bottom-tools">

  <button onclick="readAll()">🔊 Read Story</button>

  <button onclick="stopReading()">⏹ Stop</button>

  <button onclick="toggleUpload()">🖼 Change Picture</button>

</div>


<div class="upload-area" id="uploadArea" hidden>

  <label>현재 오른쪽 페이지 그림 교체하기</label>

  <input
    type="file"
    accept="image/*"
    id="imageUpload"
    onchange="changePicture(event)"
  >

  <p id="uploadStatus">
    내 기기에 있는 그림을 선택하세요.
  </p>

</div>


<script>

/* =================================================
   1. 동화책 편집 영역

   이 부분만 수정하면 새로운 동화책을 만들 수 있습니다.
================================================= */


/*
그림 경로 예시:
images/rabbit.jpg

효과음 경로 예시:
sounds/rabbit.mp3

그림 속 클릭 영역:
x, y, width, height
모두 0~100 사이의 퍼센트 값입니다.
*/


const STORY_PAGES = [

  // PAGE 1

  {
    image: "",

    background: "#e9f3e5",

    sentences: [

      "Once upon a time,",

      "there was a little rabbit."

    ],

    sounds: [

      {
        x: 10,
        y: 10,
        width: 80,
        height: 80,
        word: "Rabbit",
        sound: "",
        say: true
      }

    ]

  },


  // PAGE 2

  {
    image: "",

    background: "#e5f0fc",

    sentences: [

      "The rabbit lived in a forest.",

      "He loved beautiful flowers."

    ],

    sounds: [

      {
        x: 10,
        y: 10,
        width: 80,
        height: 80,
        word: "Flower",
        sound: "",
        say: true
      }

    ]

  },


  // PAGE 3

  {
    image: "",

    background: "#fff0dc",

    sentences: [

      "One day, he saw a little bird.",

      "The bird was singing happily."

    ],

    sounds: [

      {
        x: 10,
        y: 10,
        width: 80,
        height: 80,
        word: "Bird",
        sound: "",
        say: true
      }

    ]

  },


  // PAGE 4

  {
    image: "",

    background: "#f4eafa",

    sentences: [

      "Hello, little bird!",

      "Let's play together!"

    ],

    sounds: [

      {
        x: 10,
        y: 10,
        width: 80,
        height: 80,
        word: "Hello",
        sound: "",
        say: true
      }

    ]

  }

];



/* =================================================
   2. 예시 그림
================================================= */


function makeIllustration(emoji, color, title) {

  const svg = `

  <svg xmlns="http://www.w3.org/2000/svg"
       width="700" height="470"
       viewBox="0 0 700 470">

    <rect width="700" height="470"
          rx="25" fill="${color}"/>

    <circle cx="570" cy="90" r="48"
            fill="#fff2b0"/>

    <path d="M0 330 Q170 240 350 330 T700 310 V470 H0Z"
          fill="#a8cba0"/>

    <path d="M0 380 Q200 310 390 380 T700 350 V470 H0Z"
          fill="#7fae83"/>

    <text x="350" y="270"
          text-anchor="middle"
          font-size="160">${emoji}</text>

    <text x="350" y="430"
          text-anchor="middle"
          font-size="32"
          fill="#ffffff"
          font-family="Arial">${title}</text>

  </svg>`;

  return "data:image/svg+xml;charset=utf-8," +
    encodeURIComponent(svg);

}


// 예시 그림 자동 연결

const exampleImages = [

  makeIllustration("🐰", "#d8e9d3", "Little Rabbit"),

  makeIllustration("🌳🌸", "#d7e8f5", "Beautiful Forest"),

  makeIllustration("🐦", "#f8e3c9", "Little Bird"),

  makeIllustration("🐰🐦", "#e9d9ed", "Good Friends")

];


// 이미지가 비어 있으면 예시 그림 사용

STORY_PAGES.forEach((page, index) => {

  if (!page.image) {
    page.image = exampleImages[index % exampleImages.length];
  }

});



/* =================================================
   3. 기본 설정
================================================= */


let currentPage = 0;

let isTurning = false;

let isReading = false;

let currentUpload = {};

let readingQueue = [];



/* =================================================
   4. 음성 읽기
================================================= */


function speak(text, element) {

  speechSynthesis.cancel();

  document.querySelectorAll(".story-sentence")
    .forEach(el => el.classList.remove("active"));

  document.querySelectorAll(".word")
    .forEach(el => el.classList.remove("active"));

  const utterance = new SpeechSynthesisUtterance(text);

  utterance.lang = "en-US";

  utterance.rate = 0.85;

  utterance.pitch = 1;

  element.classList.add("active");

  const words = element.querySelectorAll(".word");

  utterance.onboundary = event => {

    if (event.name !== "word") return;

    let index = 0;
    let total = 0;

    for (let i = 0; i < words.length; i++) {

      if (total <= event.charIndex) {
        index = i;
      }

      total += words[i].textContent.length + 1;

    }

    words.forEach(w => w.classList.remove("active"));

    if (words[index]) {
      words[index].classList.add("active");
    }

  };

  utterance.onend = () => {

    element.classList.remove("active");

    words.forEach(w => w.classList.remove("active"));

  };

  speechSynthesis.speak(utterance);

}



/* =================================================
   5. 페이지 렌더링
================================================= */


function renderSide(elementId, pageIndex) {

  const container = document.getElementById(elementId);

  container.innerHTML = "";

  const data = STORY_PAGES[pageIndex];

  if (!data) return;

  container.style.background = data.background || "#fffdf7";

  const imageWrap = document.createElement("div");

  imageWrap.className = "page-image-wrap";

  const img = document.createElement("img");

  img.className = "page-image";

  img.src = currentUpload[pageIndex] || data.image;

  imageWrap.appendChild(img);


  // 그림 클릭 영역

  (data.sounds || []).forEach(area => {

    const button = document.createElement("button");

    button.className = "hotspot";

    button.style.left = area.x + "%";

    button.style.top = area.y + "%";

    button.style.width = area.width + "%";

    button.style.height = area.height + "%";

    button.title = area.word;

    button.onclick = event => {

      event.stopPropagation();

      if (area.sound) {

        const audio = new Audio(area.sound);

        audio.play().catch(() => {});

      }

      if (area.say) {

        const temp = new SpeechSynthesisUtterance(area.word);

        temp.lang = "en-US";

        temp.rate = 0.85;

        speechSynthesis.cancel();

        speechSynthesis.speak(temp);

      }

    };

    imageWrap.appendChild(button);

  });


  container.appendChild(imageWrap);


  // 문장 표시

  const textBox = document.createElement("div");

  textBox.className = "story-text";

  data.sentences.forEach(sentence => {

    const line = document.createElement("div");

    line.className = "story-sentence";

    sentence.split(/(\s+)/).forEach(part => {

      if (/^\s+$/.test(part)) {

        line.appendChild(document.createTextNode(part));

      } else {

        const span = document.createElement("span");

        span.className = "word";

        span.textContent = part;

        line.appendChild(span);

      }

    });

    line.onclick = () => speak(sentence, line);

    textBox.appendChild(line);

  });

  container.appendChild(textBox);


  // 페이지 번호

  const number = document.createElement("div");

  number.className = "page-number";

  number.textContent = pageIndex + 1;

  container.appendChild(number);

}



function renderBook() {

  renderSide("leftPage", currentPage);

  renderSide("rightPage", currentPage + 1);

  document.getElementById("pageInfo").textContent =

    `${currentPage + 1} - ${Math.min(currentPage + 2, STORY_PAGES.length)} / ${STORY_PAGES.length}`;

  document.getElementById("prevBtn").disabled = currentPage === 0;

  document.getElementById("nextBtn").disabled =

    currentPage + 2 >= STORY_PAGES.length;

}



/* =================================================
   6. 3D 페이지 넘기기
================================================= */


function turnPage(direction) {

  if (isTurning) return;

  const next = currentPage + direction * 2;

  if (next < 0 || next >= STORY_PAGES.length) return;

  isTurning = true;

  stopReading();

  const page = document.getElementById("turningPage");

  page.className = "turning-page";

  void page.offsetWidth;

  page.classList.add(direction === 1 ? "next" : "prev");

  setTimeout(() => {

    currentPage = next;

    renderBook();

    page.className = "turning-page";

    isTurning = false;

  }, 650);

}



/* =================================================
   7. 전체 이야기 읽기
================================================= */


function readAll() {

  stopReading();

  isReading = true;

  readingQueue = [];

  STORY_PAGES.forEach((page, index) => {

    page.sentences.forEach(sentence => {

      readingQueue.push({
        page: index,
        text: sentence
      });

    });

  });

  playNextSentence();

}


function playNextSentence() {

  if (!isReading || readingQueue.length === 0) {

    isReading = false;

    return;

  }

  const item = readingQueue.shift();

  const spread = Math.floor(item.page / 2) * 2;

  if (currentPage !== spread) {

    currentPage = spread;

    renderBook();

  }

  const side = item.page % 2 === 0
    ? "leftPage"
    : "rightPage";

  const container = document.getElementById(side);

  const lines = container.querySelectorAll(".story-sentence");

  const line = [...lines].find(el =>
    el.textContent === item.text
  );

  if (!line) {

    playNextSentence();

    return;

  }

  const utterance = new SpeechSynthesisUtterance(item.text);

  utterance.lang = "en-US";

  utterance.rate = 0.85;

  line.classList.add("active");

  utterance.onend = () => {

    line.classList.remove("active");

    playNextSentence();

  };

  speechSynthesis.speak(utterance);

}


function stopReading() {

  isReading = false;

  readingQueue = [];

  speechSynthesis.cancel();

}



/* =================================================
   8. 내 이미지로 교체
================================================= */


function toggleUpload() {

  const area = document.getElementById("uploadArea");

  area.hidden = !area.hidden;

}


function changePicture(event) {

  const file = event.target.files[0];

  if (!file) return;

  if (!file.type.startsWith("image/")) {

    alert("이미지 파일을 선택해주세요.");

    return;

  }

  const reader = new FileReader();

  reader.onload = function(e) {

    currentUpload[currentPage + 1] = e.target.result;

    renderBook();

    document.getElementById("uploadStatus").textContent =

      "그림이 교체되었습니다. (현재 브라우저에서만 적용)";

  };

  reader.readAsDataURL(file);

}



/* =================================================
   9. 초기 실행
================================================= */


renderBook();

</script>

</body>
</html>

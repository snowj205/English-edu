<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">

<title>트윙클 잉글리쉬 동화책</title>

<style>
* {
  box-sizing: border-box;
}

body {
  margin: 0;
  background: #e9e3d8;
  font-family: Arial, "Malgun Gothic", sans-serif;
  color: #333;
}

header {
  text-align: center;
  padding: 18px;
}

header h2 {
  margin: 0;
  color: #594c42;
}

.book-area {
  display: flex;
  justify-content: center;
  padding: 20px 12px;
}

.book {
  width: 900px;
  max-width: 100%;
  min-height: 520px;
  display: grid;
  grid-template-columns: 1fr 1fr;
  background: #fffdf5;
  border-radius: 12px;
  box-shadow: 0 15px 35px #0002;
  overflow: hidden;
  position: relative;
  perspective: 1500px;
}

.page {
  min-width: 0;
  padding: 35px;
  position: relative;
  background: #fffdf5;
}

.left-page {
  border-right: 1px solid #e8dfd0;
  box-shadow: inset -8px 0 15px -15px #555;
}

.right-page {
  box-shadow: inset 8px 0 15px -15px #555;
}

.page-content {
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.story-image {
  width: 100%;
  max-height: 300px;
  object-fit: contain;
  cursor: pointer;
  border-radius: 8px;
  transition: transform .2s;
}

.story-image:hover {
  transform: scale(1.03);
}

.story-text {
  font-size: 21px;
  line-height: 1.8;
  text-align: center;
  width: 100%;
  margin-top: 25px;
}

.sentence {
  display: block;
  cursor: pointer;
  padding: 5px;
  border-radius: 6px;
  transition: background .2s;
}

.sentence:hover {
  background: #fff0cf;
}

.sentence.active {
  background: #ffe7a8;
}

.page-number {
  position: absolute;
  bottom: 15px;
  color: #aaa;
  font-size: 13px;
}

.left-page .page-number {
  left: 25px;
}

.right-page .page-number {
  right: 25px;
}

.controls {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 18px;
  margin: 15px;
}

button {
  border: none;
  padding: 12px 22px;
  border-radius: 25px;
  background: #8d7765;
  color: white;
  cursor: pointer;
  font-size: 15px;
}

button:hover {
  background: #705b4a;
}

button:disabled {
  opacity: .3;
  cursor: default;
}

#pageInfo {
  font-size: 14px;
}

.editor {
  max-width: 900px;
  margin: 25px auto;
  padding: 20px;
  background: white;
  border-radius: 12px;
}

.editor h3 {
  margin-top: 0;
}

.editor label {
  display: block;
  margin: 15px 0 6px;
  font-weight: bold;
}

.editor textarea {
  width: 100%;
  min-height: 100px;
  padding: 12px;
  border: 1px solid #ddd;
  border-radius: 8px;
  font-size: 15px;
  resize: vertical;
}

.editor input {
  width: 100%;
  margin-top: 8px;
}

.editor-buttons {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-top: 18px;
}

.editor-buttons button {
  font-size: 13px;
}

.note {
  font-size: 13px;
  color: #888;
  line-height: 1.6;
  margin-top: 15px;
}

@keyframes turnNext {
  0% {
    transform: rotateY(0);
  }
  50% {
    transform: rotateY(-12deg);
  }
  100% {
    transform: rotateY(0);
  }
}

@keyframes turnPrev {
  0% {
    transform: rotateY(0);
  }
  50% {
    transform: rotateY(12deg);
  }
  100% {
    transform: rotateY(0);
  }
}

.turn-next {
  animation: turnNext .4s ease;
}

.turn-prev {
  animation: turnPrev .4s ease;
}

@media(max-width:650px) {

  .book {
    min-height: 430px;
  }

  .page {
    padding: 15px 10px 30px;
  }

  .story-image {
    max-height: 210px;
  }

  .story-text {
    font-size: 15px;
    line-height: 1.7;
    margin-top: 15px;
  }

  button {
    padding: 10px 15px;
    font-size: 13px;
  }

  header h2 {
    font-size: 20px;
  }

}
</style>
</head>

<body>

<header>
  <h2>📖 트윙클 잉글리쉬 Storybook</h2>
</header>

<div class="book-area">

  <div class="book" id="book">

    <div class="page left-page">
      <div class="page-content" id="leftContent"></div>
      <div class="page-number" id="leftNumber"></div>
    </div>

    <div class="page right-page">
      <div class="page-content" id="rightContent"></div>
      <div class="page-number" id="rightNumber"></div>
    </div>

  </div>

</div>

<div class="controls">

  <button id="prevBtn" onclick="changePage(-1)">
    ◀ 이전
  </button>

  <span id="pageInfo"></span>

  <button id="nextBtn" onclick="changePage(1)">
    다음 ▶
  </button>

</div>


<!-- 편집 영역 -->

<div class="editor">

  <h3>✏️ 동화책 편집하기</h3>

  <label>왼쪽 페이지 문장</label>
  <textarea id="leftText"></textarea>

  <label>오른쪽 페이지 문장</label>
  <textarea id="rightText"></textarea>

  <label>왼쪽 페이지 그림</label>
  <input type="file" id="leftImage" accept="image/*">

  <label>오른쪽 페이지 그림</label>
  <input type="file" id="rightImage" accept="image/*">

  <label>왼쪽 페이지 그림 효과음</label>
  <input type="file" id="leftSound" accept="audio/*">

  <label>오른쪽 페이지 그림 효과음</label>
  <input type="file" id="rightSound" accept="audio/*">

  <div class="editor-buttons">

    <button onclick="saveEdit()">변경 내용 저장</button>

    <button onclick="addPage()">페이지 추가</button>

    <button onclick="deletePage()">페이지 삭제</button>

  </div>

  <p class="note">
    • 문장은 한 줄에 한 문장씩 입력하세요.<br>
    • 영어 문장을 클릭하면 음성이 재생됩니다.<br>
    • 그림을 클릭하면 지정한 효과음이 재생됩니다.<br>
    • 업로드한 자료는 이 브라우저에 저장됩니다.
  </p>

</div>


<script>

// 기본 동화책 내용

const defaultPages = [

  {
    text: [
      "Once upon a time,",
      "there was a little rabbit."
    ],
    image: "",
    sound: ""
  },

  {
    text: [
      "The rabbit lived in a forest.",
      "He liked to play every day."
    ],
    image: "",
    sound: ""
  },

  {
    text: [
      "One day, he saw a big tree.",
      "It was very tall!"
    ],
    image: "",
    sound: ""
  },

  {
    text: [
      "He found a little bird.",
      "They became good friends."
    ],
    image: "",
    sound: ""
  }

];

let pages = JSON.parse(
  localStorage.getItem("storybookData")
) || defaultPages;

let currentPage = 0;


// 음성 읽기

function speak(text, element) {

  speechSynthesis.cancel();

  document.querySelectorAll(".sentence")
    .forEach(el => el.classList.remove("active"));

  element.classList.add("active");

  const utterance = new SpeechSynthesisUtterance(text);

  utterance.lang = "en-US";
  utterance.rate = 0.85;
  utterance.pitch = 1;

  utterance.onend = () => {
    element.classList.remove("active");
  };

  speechSynthesis.speak(utterance);

}


// 효과음 재생

function playSound(src) {

  if (!src) return;

  const audio = new Audio(src);

  audio.play().catch(() => {});

}


// 페이지 표시

function renderPage() {

  const left = pages[currentPage];
  const right = pages[currentPage + 1];

  renderSide("left", left);
  renderSide("right", right);

  document.getElementById("pageInfo").textContent =
    `${currentPage + 1} - ${Math.min(currentPage + 2, pages.length)} / ${pages.length}`;

  document.getElementById("prevBtn").disabled =
    currentPage === 0;

  document.getElementById("nextBtn").disabled =
    currentPage + 2 >= pages.length;

  loadEditor();

}


function renderSide(side, data) {

  const content = document.getElementById(
    side + "Content"
  );

  const number = document.getElementById(
    side + "Number"
  );

  content.innerHTML = "";

  if (!data) {
    number.textContent = "";
    return;
  }

  // 그림

  if (data.image) {

    const img = document.createElement("img");

    img.src = data.image;
    img.className = "story-image";

    img.onclick = () => playSound(data.sound);

    content.appendChild(img);

  }

  // 문장

  const textBox = document.createElement("div");

  textBox.className = "story-text";

  data.text.forEach(sentence => {

    const span = document.createElement("span");

    span.className = "sentence";
    span.textContent = sentence;

    span.onclick = () => speak(sentence, span);

    textBox.appendChild(span);

  });

  content.appendChild(textBox);

  number.textContent =
    pages.indexOf(data) + 1;

}


// 페이지 넘기기

function changePage(direction) {

  const book = document.getElementById("book");

  speechSynthesis.cancel();

  if (direction === 1) {

    if (currentPage + 2 >= pages.length) return;

    currentPage += 2;

    book.classList.remove("turn-prev");
    book.classList.add("turn-next");

  } else {

    if (currentPage === 0) return;

    currentPage -= 2;

    book.classList.remove("turn-next");
    book.classList.add("turn-prev");

  }

  setTimeout(() => {

    renderPage();

    book.classList.remove("turn-next", "turn-prev");

  }, 200);

}


// 편집기 내용 불러오기

function loadEditor() {

  const left = pages[currentPage];
  const right = pages[currentPage + 1];

  document.getElementById("leftText").value =
    left ? left.text.join("\n") : "";

  document.getElementById("rightText").value =
    right ? right.text.join("\n") : "";

}


// 이미지 파일 읽기

function readFile(input) {

  return new Promise(resolve => {

    const file = input.files[0];

    if (!file) {
      resolve(null);
      return;
    }

    const reader = new FileReader();

    reader.onload = () => resolve(reader.result);

    reader.readAsDataURL(file);

  });

}


// 편집 내용 저장

async function saveEdit() {

  const left = pages[currentPage];
  const right = pages[currentPage + 1];

  if (left) {

    left.text = document.getElementById("leftText")
      .value.split("\n").filter(x => x.trim());

    const img = await readFile(
      document.getElementById("leftImage")
    );

    const sound = await readFile(
      document.getElementById("leftSound")
    );

    if (img) left.image = img;
    if (sound) left.sound = sound;

  }

  if (right) {

    right.text = document.getElementById("rightText")
      .value.split("\n").filter(x => x.trim());

    const img = await readFile(
      document.getElementById("rightImage")
    );

    const sound = await readFile(
      document.getElementById("rightSound")
    );

    if (img) right.image = img;
    if (sound) right.sound = sound;

  }

  try {

    localStorage.setItem(
      "storybookData",
      JSON.stringify(pages)
    );

    alert("저장되었습니다!");

    renderPage();

  } catch (error) {

    alert("저장 공간이 부족합니다. 이미지 크기를 줄여주세요.");

  }

}


// 페이지 추가

function addPage() {

  if (pages.length % 2 !== 0) {

    pages.push({
      text: [],
      image: "",
      sound: ""
    });

  } else {

    pages.push({
      text: [],
      image: "",
      sound: ""
    });

  }

  currentPage = Math.floor((pages.length - 1) / 2) * 2;

  saveAll();

  renderPage();

}


// 페이지 삭제

function deletePage() {

  if (pages.length <= 2) {
    alert("최소 두 페이지는 남겨주세요.");
    return;
  }

  pages.splice(currentPage, 2);

  currentPage = Math.min(
    currentPage,
    Math.max(0, Math.floor((pages.length - 1) / 2) * 2)
  );

  saveAll();
  renderPage();

}


// 전체 저장

function saveAll() {

  localStorage.setItem(
    "storybookData",
    JSON.stringify(pages)
  );

}


// 처음 실행

renderPage();

</script>

</body>
</html>
